diff --git a/src/libstore/filetransfer.cc b/src/libstore/filetransfer.cc
--- a/src/libstore/filetransfer.cc
+++ b/src/libstore/filetransfer.cc
@@ -20,7 +20,9 @@
 #include <unistd.h>
 #include <fcntl.h>
 
+#if NIX_WITH_CURL_HTTP
 #include <curl/curl.h>
+#endif
 
 #include <cmath>
 #include <cstring>
@@ -53,6 +55,7 @@ FileTransferSettings::FileTransferSettings()
 FileTransferSettings fileTransferSettings;
 
 static GlobalConfig::Register rFileTransferSettings(&fileTransferSettings);
+#if NIX_WITH_CURL_HTTP
 
 namespace {
 
@@ -1056,6 +1059,38 @@ ref<FileTransfer> makeFileTransfer(const FileTransferSettings & settings)
 {
     return makeCurlFileTransfer(settings);
 }
+#else
+namespace {
+
+struct DisabledFileTransfer final : FileTransfer
+{
+    struct DisabledItem final : Item {} item;
+
+    ItemHandle enqueueFileTransfer(const FileTransferRequest &, Callback<FileTransferResult> callback) override
+    {
+        callback.rethrow(std::make_exception_ptr(FileTransferError(
+            FileTransfer::Misc,
+            std::nullopt,
+            "this Nix build was compiled without HTTP file transfer support")));
+        return ItemHandle(item);
+    }
+
+    void unpauseTransfer(ItemHandle) override {}
+};
+
+} // namespace
+
+ref<FileTransfer> getFileTransfer()
+{
+    static ref<DisabledFileTransfer> fileTransfer = make_ref<DisabledFileTransfer>();
+    return fileTransfer;
+}
+
+ref<FileTransfer> makeFileTransfer(const FileTransferSettings &)
+{
+    return make_ref<DisabledFileTransfer>();
+}
+#endif
 
 void FileTransferRequest::setupForS3()
 {
